DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4000
UPLOAD_DIR="./uploads"
# Optional: enables real MaaS transit directions (Geocoding + Directions API).
# Leave unset to use the built-in mock transit data instead. See README for setup.
GOOGLE_MAPS_API_KEY=

# AI travel concierge (「AIに旅を相談」). Without it the concierge falls back to keyword matching.
ANTHROPIC_API_KEY=
# AI model (default claude-sonnet-5-5) and the app's AI budget in US$ (estimated
# from the tokens used); past it, the AI features answer without AI until the
# next day/month. Also set a monthly spend limit in the Anthropic Console.
# CLAUDE_MODEL=claude-sonnet-5-5
# AI_MONTHLY_BUDGET_USD=300
# AI_DAILY_BUDGET_USD=20

# 有料プラン (Stripe). Without STRIPE_SECRET_KEY the plans are shown but can't be
# bought. The prices are recurring monthly Prices in the Stripe dashboard (keep
# the amounts the same as backend/src/lib/plans.ts). The webhook endpoint is
# <backend URL>/api/billing/webhook. APP_ORIGIN: the frontend URL (Stripe sends
# people back there after paying).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS=price_...
# STRIPE_PRICE_BUSINESS=price_...
# APP_ORIGIN=https://jaziba.example.com

# Web Push (プッシュ通知). Optional: without them a key pair is generated once
# and stored in the database — set fixed ones in production so subscriptions
# survive a database reset. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or https://your-site
VAPID_SUBJECT=

# 管理者サイト (/admin): the email addresses of the accounts that may use it,
# comma-separated. Sign up with that address as a normal traveler first.
# ADMIN_EMAILS=you@example.com

# 登録の承認: new municipality and company accounts wait for approval in the
# admin site before they can post. Set to "off" to skip it (e.g. a demo).
# POSTER_APPROVAL=off
