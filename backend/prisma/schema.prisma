datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// SQLite has no native enum support; role is validated in application code (see src/types.ts)
// Valid values: "USER" | "MUNICIPALITY" | "COMPANY"
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  avatarUrl    String?
  // Optional self-reported attributes, collected at registration or later from
  // Settings. Used only to power anonymized, aggregated audience breakdowns
  // (nationality / age) for municipality & company accounts — see ReelView.
  // Never shown to other individual viewers, and never required.
  nationality  String?
  birthYear    Int?
  // Whether to notify this user when someone likes/comments on their content.
  // Stored for future use — the app has no notification delivery mechanism
  // (push/email) yet, so these currently have no visible effect.
  notifyOnLike    Boolean  @default(true)
  notifyOnComment Boolean  @default(true)
  // Travelers: お知らせ when a municipality/company they follow posts.
  notifyOnNewPost Boolean  @default(true)
  // Optional travel style, set from Settings, used only to personalize the
  // おすすめ feed (see lib/personalize.ts). travelCompanion is one of
  // TRAVEL_COMPANIONS; favoriteCategories is a comma-separated subset of
  // REEL_CATEGORIES.
  travelCompanion    String?
  needsBarrierFree   Boolean  @default(false)
  needsMultilingual  Boolean  @default(false)
  favoriteCategories String   @default("")
  // しおり trip settings: where the trip starts (free text, like the access
  // planner's origin) and the start time of day ("HH:MM").
  itineraryOrigin    String   @default("")
  itineraryStartTime String   @default("09:00")
  // Set while the traveler shares a read-only link to their しおり
  // (/trip/:token); cleared when they stop sharing, which kills the link.
  itineraryShareToken String?  @unique
  createdAt    DateTime @default(now())

  municipality Municipality?
  company      Company?
  likes        Like[]
  comments     Comment[]
  reelViews    ReelView[]
  savedReels   SavedReel[]
  follows      Follow[]
  travelReports TravelTimeReport[]
  notifications       Notification[] @relation("NotificationRecipient")
  notificationsCaused Notification[] @relation("NotificationActor")
  visits        Visit[]
  commentReports CommentReport[]
  pushSubscriptions PushSubscription[]
  trips         Trip[]
  tripMemberships TripMember[]
  passkeys      Passkey[]
}

model Municipality {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  prefecture     String
  description    String   @default("")
  avatarUrl      String?
  accessInfo     String   @default("")
  lodgingInfo    String   @default("")
  restaurantInfo String   @default("")
  otaLinks       String   @default("[]") // JSON string: [{ label, url }]
  // Reference point ("最寄り駅" / main access hub) used as the origin for real
  // transit directions (see src/services/maasProvider.ts). Geocoded server-side
  // from nearestStationName when saved, if a Google Maps API key is configured.
  nearestStationName String   @default("")
  nearestStationLat  Float?
  nearestStationLng  Float?
  // Whether tourists can comment on this municipality's reels (including ones
  // posted by its linked companies). Toggled from Settings.
  commentsEnabled    Boolean  @default(true)
  // From public data (src/data/naganoMunicipalities.ts): reading, official
  // site, 地方公共団体コード and the city hall / town office position.
  kana               String   @default("")
  websiteUrl         String   @default("")
  lgCode             String?  @unique
  officeLat          Float?
  officeLng          Float?
  // A page Jaziba made from public data for a municipality that hasn't
  // joined: no one can sign in to it, and the profile says so.
  listing            Boolean  @default(false)
  createdAt          DateTime @default(now())

  reels        Reel[]
  companies    Company[]
  followers    Follow[]
  tourismSpots TourismSpot[]
  events       Event[]
}

// One tourist attraction within a municipality's jurisdiction — the 観光情報
// ("tourism info") tab used to be a single free-text field per municipality;
// this replaces it so a municipality can list out each spot in its area
// individually (name + description), edited from the dashboard's 投稿 tab's
// neighbor and shown as a list on the public profile's 観光情報 tab.
model TourismSpot {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  // Optional location, so the spot can show up in 近くの観光スポット. Set by the
  // municipality, or looked up from the spot + municipality name when
  // Google Maps is configured (see lib/locateTourismSpot.ts).
  locationLat    Float?
  locationLng    Float?
  createdAt      DateTime     @default(now())
}

// A company/business account tied to exactly one municipality. Companies can post
// reels that appear under their municipality, but only manage their own posts —
// the municipality account can manage all reels under its name, including the
// ones companies posted (see role-based checks in src/routes/reels.ts).
model Company {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  name           String
  avatarUrl      String?
  // Whether tourists can comment on this company's own reels. Toggled from Settings.
  commentsEnabled Boolean  @default(true)
  createdAt      DateTime @default(now())

  reels     Reel[]
  followers Follow[]
  events    Event[]
}

model Reel {
  id             String   @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  videoUrl       String
  thumbnailUrl   String?
  caption        String   @default("")
  locationName   String?
  locationLat    Float?
  locationLng    Float?
  // One of: "nature" | "culture" | "activity" | "lodging" | "restaurant" — chosen by
  // the poster at upload time, used to filter the main feed into category tabs.
  category       String   @default("nature")
  // Comma-separated subset of TRAVELER_TAGS (see src/types.ts), e.g.
  // "barrierFree,familyFriendly" — who/what the spot suits, set by the poster.
  travelerTags   String   @default("")
  // 見頃: comma-separated months (1–12) when the place is at its best, e.g.
  // "4,5" for spring flowers — chosen by the poster. Empty means not stated.
  bestMonths     String   @default("")
  // An introduction Jaziba's editors wrote for a municipality that hasn't
  // joined (see lib/municipalityListings.ts) — never shown as the town's own
  // post; its video is an illustration.
  editorial      Boolean  @default(false)
  viewCount      Int      @default(0)
  createdAt      DateTime @default(now())

  likes    Like[]
  comments Comment[]
  views    ReelView[]
  saves    SavedReel[]
  travelReports TravelTimeReport[]
  notifications Notification[]
  translations  ReelTranslation[]
  tripItems     TripItem[]
  visits        Visit[]
}

// スタンプラリー: a traveler checked in at a post's spot (within
// VISIT_RADIUS_METERS of it, by the browser's location). One stamp per spot.
model Visit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reelId])
}

// Machine translations of a reel's caption (Claude), cached so each
// caption/language pair is translated once. Cleared when the caption changes.
model ReelTranslation {
  id        String   @id @default(cuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  lang      String
  caption   String
  createdAt DateTime @default(now())

  @@unique([reelId, lang])
}

// One row per reel view, kept (rather than just incrementing a counter) so
// municipality/company accounts can see anonymized, aggregated audience
// breakdowns by nationality and age bucket — see GET /reels/mine/demographics.
// viewerId is null for logged-out viewers: they still count toward totals but
// can't be attributed to any demographic.
model ReelView {
  id        String   @id @default(cuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  viewerId  String?
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([reelId])
  @@index([viewerId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, reelId])
}

// A user bookmarking a reel to find again later — see the feed's "保存中" tab
// (GET /reels/saved).
model SavedReel {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  // しおり order set by the user (PUT /reels/itinerary/order). Null until they
  // reorder; unpositioned saves sort after positioned ones, by save time.
  position    Int?
  // How long the user plans to stay at this stop — drives the しおり timeline.
  stayMinutes Int      @default(60)
  createdAt DateTime @default(now())

  @@unique([userId, reelId])
}

// A user following a municipality or a company (never both in the same row) to
// get their reels in the feed's "フォロー中" tab — see GET /reels/following.
// Both foreign keys are optional; exactly one is set per row. SQLite/Prisma
// treat NULL as distinct in unique indexes, so the two @@unique constraints
// below only actually dedupe the column that's populated for a given row.
model Follow {
  id             String   @id @default(cuid())
  followerId     String
  follower       User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([followerId, municipalityId])
  @@unique([followerId, companyId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  notifications Notification[]
  reports   CommentReport[]
  translations CommentTranslation[]
}

// Cached Claude translation of a comment into one UI language. Comments
// can't be edited, so a cached translation never goes stale.
model CommentTranslation {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  lang      String
  body      String
  createdAt DateTime @default(now())

  @@unique([commentId, lang])
}

// 通報: a user flags someone else's comment. At COMMENT_HIDE_THRESHOLD
// distinct reporters the comment is hidden from everyone but its author and
// the account managing the post, who reviews it (delete, or dismiss reports).
model CommentReport {
  id         String   @id @default(cuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  // "spam" | "abuse" | "other"
  reason     String
  createdAt  DateTime @default(now())

  @@unique([commentId, reporterId])
}

// Public contact-form submissions (no login required to send one). There's no
// admin role/inbox UI in this app yet, so the operator currently reads these via
// `npx prisma studio` or a direct DB query — see README.
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

// A traveler's self-reported "it actually took me N minutes" for getting to a
// reel's location by one transport mode — the pitch deck's 「平均所要時間はユーザー
// 自身がポイント獲得のために計測」. Each report earns points (see lib/points.ts),
// and reports are aggregated per starting point + mode into the 「みんなの実測」
// averages shown on the access page. One row per (user, reel, mode): re-recording overwrites it,
// so repeating the same report can't farm extra points.
model TravelTimeReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reelId      String
  reel        Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  // "train" | "bus" | "car" | "taxi" | "walk" — same set as the access page's mode cards.
  mode        String
  durationMin Int
  // Where the trip started, as typed (normalized whitespace) — averages are
  // grouped by it, since actual times only compare from the same origin.
  originLabel String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, reelId, mode])
  @@index([reelId])
}

// In-app お知らせ for the account that posted a reel: someone liked it or
// commented on it. Only created when the recipient's notifyOnLike /
// notifyOnComment setting is on, and never for their own actions. Devices
// that opted in also get each one as a Web Push (see PushSubscription).
model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  // "like" | "comment" | "newPost" (to followers of the poster)
  type        String
  reelId      String
  reel        Reel      @relation(fields: [reelId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Set for comment notifications; deleting the comment removes the notification.
  commentId   String?
  comment     Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
}

// イベント情報: festivals, markets, seasonal events posted by a municipality
// (or a company under it). Dates are calendar days ("YYYY-MM-DD", local to
// Japan) since events are listed by day, not by instant.
model Event {
  id             String       @id @default(cuid())
  municipalityId String
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  description    String       @default("")
  startDate      String
  endDate        String
  locationName   String       @default("")
  url            String       @default("")
  createdAt      DateTime     @default(now())

  @@index([endDate])
}

// A browser/device that agreed to Web Push for this account (Settings →
// プッシュ通知). Each お知らせ is also pushed to these; one the push service
// reports gone (404/410) is deleted. `lang` is the UI language at subscribe
// time, used for the notification text.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  lang      String   @default("ja")
  createdAt DateTime @default(now())
}

// パスキー (WebAuthn): sign in with the device's face/fingerprint/PIN instead
// of the password. `id` is the credential id (base64url); the public key
// verifies each sign-in, and `counter` helps spot cloned authenticators.
model Passkey {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  counter    Int       @default(0)
  // Comma-separated authenticator transports ("internal,hybrid").
  transports String    @default("")
  // Synced across the user's devices (iCloud Keychain, Google Password Manager).
  backedUp   Boolean   @default(false)
  // A label the user sees ("iPhone", "Mac"...), guessed from the browser.
  name       String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// Small server-wide values that must survive restarts, e.g. the generated
// Web Push (VAPID) key pair when none is configured in the environment.
model AppSetting {
  key   String @id
  value String
}

// 旅: a traveler's trip ("京都 2泊3日"), made first, then filled by choosing
// it when bookmarking a post. Each trip is its own しおり: its own order, stay
// times, start point/time, date and share link. A post can be in several
// trips. SavedReel stays the "bookmarked at all" record: it exists exactly
// while the post is in at least one of the user's trips (routes/trips.ts
// keeps the two in step). The itinerary*/position/stayMinutes columns on
// User and SavedReel are from before trips and are no longer used.
model Trip {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // Optional first day, "YYYY-MM-DD" (calendar export, 旅行中モード).
  startDate   String?
  originLabel String     @default("")
  startTime   String     @default("09:00")
  // Set while a read-only link (/trip/:token) is shared.
  shareToken  String?    @unique
  // Set while an invite link (/join/:token) lets companions join and edit.
  inviteToken String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       TripItem[]
  members     TripMember[]

  @@index([userId])
}

// 一緒に計画する人: companions who joined a trip with its invite link. They
// can edit its しおり like the owner (add, remove, reorder, settings, plan);
// only the owner can delete the trip or manage its links and members.
model TripMember {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
}

model TripItem {
  id          String   @id @default(cuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reelId      String
  reel        Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  position    Int
  stayMinutes Int      @default(60)
  createdAt   DateTime @default(now())

  @@unique([tripId, reelId])
}
